<Window x:Class="Prestamo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prestamo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="50,0,50,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Cliente:" FontWeight="Bold" FontSize="16" Margin="0,0,10,0"/>
            <TextBox x:Name="txtCliente" Grid.Column="1" Height="26"/>
            <TextBlock Text="Monto a pagar:" Grid.Column="3" FontWeight="Bold" FontSize="16" Margin="0,0,10,0"/>
            <TextBox x:Name="txtMonto" Grid.Column="4" Height="26"/>
        </Grid>

        <Grid Margin="50,0,50,20" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="73"/>
                <ColumnDefinition Width="Auto" MinWidth="109.033"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Fch.Ven:" FontWeight="Bold" FontSize="16" Margin="0,0,10,0"/>
            <DatePicker x:Name="dtpFechaVencimiento" Grid.Column="1" Height="26"/>
            <TextBlock Text="Fch.Pago:" Grid.Column="3" FontWeight="Bold" FontSize="16" Margin="9,0,10,0"/>
            <DatePicker x:Name="dtpFechaPago" Grid.Column="4" Height="26"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,30,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Calcular" Height="30" Width="100"  HorizontalAlignment="Center" Click="btnCalcular_Click" Margin="100,0,50,0" Grid.Column="0"/>
            <Button Content="Nuevo" Height="30" Width="100"  HorizontalAlignment="Center" Click="btnNuevo_Click" Margin="50,0,50,0" Grid.Column="1"/>
            <Button Content="Finalizar" Height="30" Width="100"  HorizontalAlignment="Center" Click="btnFinalizar_Click" Margin="50,0,50,0" Grid.Column="2"/>
        </Grid>

        <Grid Grid.Row="3" Margin="50,50,50,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Dias de Mora:" FontWeight="Bold" FontSize="16" Margin="0,0,10,0"/>
            <TextBox x:Name="txtDiasMora" Grid.Column="1" Height="26" Background="#FFDE21" IsReadOnly="True"/>
            <TextBlock Text="Mora en $.:" Grid.Column="3" FontWeight="Bold" FontSize="16" Margin="0,0,10,0"/>
            <TextBox x:Name="txtMora" Grid.Column="4" Height="26" Background="#FFDE21" IsReadOnly="True"/>
        </Grid>

        <Grid Grid.Row="4" Margin="50,0,50,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Mora en %:" FontWeight="Bold" FontSize="16" Margin="0,0,10,0"/>
            <TextBox x:Name="txtMoraPorcentaje" Grid.Column="1" Height="26" Background="#FFDE21" IsReadOnly="True"/>
            <TextBlock Text="Monto a Pagar:" Grid.Column="3" FontWeight="Bold" FontSize="16" Margin="0,0,10,0"/>
            <TextBox x:Name="txtMontoTotal" Grid.Column="4" Height="26" Background="#FFDE21" IsReadOnly="True"/>
        </Grid>

    </Grid>
</Window>
